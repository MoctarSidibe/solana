[Unit]
Description=SunPark Helius webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunpark
Group=sunpark
WorkingDirectory=/var/www/sunpark
EnvironmentFile=/var/www/sunpark/.env
ExecStart=/var/www/sunpark/.venv/bin/python /var/www/sunpark/webhook.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/www/sunpark/data

[Install]
WantedBy=multi-user.target
